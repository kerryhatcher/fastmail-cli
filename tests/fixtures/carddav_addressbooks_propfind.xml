<?xml version="1.0" encoding="utf-8"?>
<d:multistatus xmlns:d="DAV:"
               xmlns:card="urn:ietf:params:xml:ns:carddav">

  <!-- parent collection response — no card:addressbook, will be skipped by parser -->
  <d:response>
    <d:href>/dav/addressbooks/user/test@example.com/</d:href>
    <d:propstat>
      <d:prop>
        <d:displayname>Address Books</d:displayname>
        <d:resourcetype>
          <d:collection/>
        </d:resourcetype>
      </d:prop>
      <d:status>HTTP/1.1 200 OK</d:status>
    </d:propstat>
  </d:response>

  <d:response>
    <d:href>/dav/addressbooks/user/test@example.com/Default/</d:href>
    <d:propstat>
      <d:prop>
        <d:displayname>Default</d:displayname>
        <d:resourcetype>
          <d:collection/>
          <card:addressbook/>
        </d:resourcetype>
      </d:prop>
      <d:status>HTTP/1.1 200 OK</d:status>
    </d:propstat>
  </d:response>

</d:multistatus>
